{
  "name": "open-payments-ilp",
  "version": "0.1.0-alpha.3",
  "description": "Web Standards toolkit for Open Payments and Interledger: ILP/IL-DCP/STREAM codecs, RFC 9421 HTTP message signatures, GNAP server, Open Payments client, Rafiki webhooks, a Better Auth GNAP plugin and Hono GNAP middleware. Effect-native, with Promise entry points under /plain/*.",
  "keywords": [
    "better-auth",
    "effect",
    "gnap",
    "hono",
    "http-message-signatures",
    "ilp",
    "interledger",
    "open-payments",
    "rafiki",
    "stream",
    "webhooks"
  ],
  "homepage": "https://github.com/dayjobdoor/open-payments-ilp#readme",
  "bugs": "https://github.com/dayjobdoor/open-payments-ilp/issues",
  "license": "Apache-2.0",
  "author": "dayjobdoor <dayjobdoor@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayjobdoor/open-payments-ilp.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./ilp": {
      "types": "./dist/ilp/index.d.ts",
      "default": "./dist/ilp/index.js"
    },
    "./ildcp": {
      "types": "./dist/ildcp/index.d.ts",
      "default": "./dist/ildcp/index.js"
    },
    "./stream": {
      "types": "./dist/stream/index.d.ts",
      "default": "./dist/stream/index.js"
    },
    "./http-signatures": {
      "types": "./dist/http-signatures/index.d.ts",
      "default": "./dist/http-signatures/index.js"
    },
    "./open-payments": {
      "types": "./dist/open-payments/index.d.ts",
      "default": "./dist/open-payments/index.js"
    },
    "./gnap": {
      "types": "./dist/gnap/index.d.ts",
      "default": "./dist/gnap/index.js"
    },
    "./gnap/server": {
      "types": "./dist/gnap/server/index.d.ts",
      "default": "./dist/gnap/server/index.js"
    },
    "./gnap/server/testing": {
      "types": "./dist/gnap/server/testing/index.d.ts",
      "default": "./dist/gnap/server/testing/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "default": "./dist/webhooks/index.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth/index.d.ts",
      "default": "./dist/better-auth/index.js"
    },
    "./better-auth/client": {
      "types": "./dist/better-auth/client.d.ts",
      "default": "./dist/better-auth/client.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./plain/ilp": {
      "types": "./dist/plain/ilp.d.ts",
      "default": "./dist/plain/ilp.js"
    },
    "./plain/ildcp": {
      "types": "./dist/plain/ildcp.d.ts",
      "default": "./dist/plain/ildcp.js"
    },
    "./plain/http-signatures": {
      "types": "./dist/plain/http-signatures.d.ts",
      "default": "./dist/plain/http-signatures.js"
    },
    "./plain/open-payments": {
      "types": "./dist/plain/open-payments.d.ts",
      "default": "./dist/plain/open-payments.js"
    },
    "./plain/stream": {
      "types": "./dist/plain/stream.d.ts",
      "default": "./dist/plain/stream.js"
    },
    "./plain/webhooks": {
      "types": "./dist/plain/webhooks.d.ts",
      "default": "./dist/plain/webhooks.js"
    },
    "./plain/gnap": {
      "types": "./dist/plain/gnap.d.ts",
      "default": "./dist/plain/gnap.js"
    },
    "./plain/gnap/server": {
      "types": "./dist/plain/gnap/server.d.ts",
      "default": "./dist/plain/gnap/server.js"
    },
    "./plain/gnap/server/testing": {
      "types": "./dist/plain/gnap/server/testing.d.ts",
      "default": "./dist/plain/gnap/server/testing.js"
    },
    "./plain/better-auth": {
      "types": "./dist/plain/better-auth.d.ts",
      "default": "./dist/plain/better-auth.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "generate:types": "bun scripts/generate-types.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && vp test run && vp pack"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@interledger/http-signature-utils": "2.0.3",
    "@interledger/open-payments": "^7.4.0",
    "@interledger/openapi": "2.0.4",
    "@interledger/stream-receiver": "^0.3.3-alpha.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.18",
    "effect": "^4.1.2",
    "hono": "^4.13.17",
    "ilp-packet": "^3.1.4-alpha.2",
    "ilp-protocol-ildcp": "^2.2.4-alpha.2",
    "ilp-protocol-stream": "^2.7.2-alpha.3",
    "json-canonicalize": "3.0.1",
    "openapi-typescript": "7.13.0",
    "pg": "^8.23.1",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "peerDependencies": {
    "better-auth": "^1.6.19",
    "effect": "^4.0.0",
    "hono": "^4.7.11"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  }
}
